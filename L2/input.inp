&GLOBAL
  PROJECT l2_rirs_gw_min
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_for_excited_states
    BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &QS
      METHOD GPW
    &END QS

    ! Benchmark only: one diagonalization is enough to generate occupied + virtual MOs.
    ! The resulting GW energies are not intended to be physically meaningful.
    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 1
      IGNORE_CONVERGENCE_FAILURE
      ADDED_MOS 100
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
    &END POISSON
  &END DFT

  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        ! Reduced from production 30; peak contraction dimensions are unchanged.
        NUM_TIME_FREQ_POINTS 10
        CUTOFF_RADIUS_RI 7.0
        EPS_FILTER 1.0E-10
        &RI_RS
          GRID_SELECT 1
          CUTOFF_RADIUS_RL_AO 7.0
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            RS_AO_RATIO 5.0
            MAX_ITER 300
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES

  &SUBSYS
    &CELL
      ABC 19.19 19.28 11.55
      PERIODIC NONE
    &END CELL

    &KIND H
      BASIS_SET ORB aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_005_s_p_d_f_g_h_i_2_1_0_0_0_0_0_error_6.8e-04
      POTENTIAL GTH-PBE-q1
    &END KIND

    &KIND C
      BASIS_SET ORB aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_030_s_p_d_f_g_h_i_4_3_2_1_0_0_0_error_3.2e-05
      POTENTIAL GTH-PBE-q4
    &END KIND

    &TOPOLOGY
      COORD_FILE_NAME struc_l2.xyz
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
